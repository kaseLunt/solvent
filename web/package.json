{
  "name": "solvent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Solvent web app (P5) — the public, verifiable risk-control surface. Next.js App Router consuming @solvent/client as the only data path.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ensure-client.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-client.mjs",
    "build": "next build",
    "start": "next start -p 3111",
    "pretypecheck": "node scripts/ensure-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@solvent/client": "file:../packages/client-ts",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  }
}
