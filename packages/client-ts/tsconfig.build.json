{
  // Emit configuration: src only, producing exactly the dist the exports map
  // names (dist/index.js + dist/index.d.ts). Tests and fixtures never ship.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
